APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bookleaf_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5433/bookleaf_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Auth
JWT_SECRET=supersecret_jwt_key_bookleaf_production_2026_xyz123!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Provider Boundary (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
