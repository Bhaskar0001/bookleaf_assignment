# BookLeaf Backend Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bookleaf_db
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/bookleaf_db

# Background Task Routing
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiter
RATE_LIMIT_ENABLED=true

# Security
JWT_SECRET=supersecret_jwt_key_bookleaf_production_2026_xyz123!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
